rules_version = '2';

// Deploy this in the Firebase console: Firestore Database → Rules tab → paste → Publish.
// (Or `firebase deploy --only firestore:rules` if you have the Firebase CLI set up.)
// This isn't applied automatically — Firebase Console rules aren't stored in this repo.

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = one of the permanent super-admin accounts, OR any player doc
    // with role == 'admin' (promoted by an existing admin from admin.html).
    // The super-admin emails can never be locked out, since they don't
    // depend on any Firestore data existing.
    function isSuperAdminEmail(email) {
      return email == "ocpc.pickleball@gmail.com" || email == "jamescastillo37@gmail.com";
    }

    function isAdmin() {
      return request.auth != null && (
        isSuperAdminEmail(request.auth.token.email)
        || get(/databases/$(database)/documents/players/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Limited-scope staff roles, distinct from full admin: a Coach can only
    // see/update their own assigned coaching requests (never payment info),
    // a Court Manager can only log/view attendance. Neither can touch
    // anything else an admin can.
    function hasRole(role) {
      return request.auth != null
        && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.role == role;
    }

    // Existing open-play attendance log. Public can read (leaderboard/spotlight
    // widgets need this); admins and Court Managers can write.
    match /attendance/{sessionId} {
      allow read: if true;
      allow write: if isAdmin() || hasRole('court_manager');
    }

    // Full player membership records — PII (address/phone/email) lives here.
    // Document ID == the player's Firebase Auth UID, created at signup
    // (join.html creates the auth account first, then this doc).
    // A player can create/read/update only their OWN doc, and can't touch
    // status/sessionsAttended/promotedAt/role (all admin-controlled) —
    // full read/write for admins.
    match /players/{playerId} {
      allow create: if request.auth != null && request.auth.uid == playerId
        && request.resource.data.status == 'pending'
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0;

      allow read: if request.auth != null
        && (request.auth.uid == playerId || isAdmin());

      // A protected (super-admin) player's status can't be changed by
      // anyone, including other admins — this is what keeps their
      // membership from ever being revoked.
      allow update: if (
        isAdmin()
        && !(resource.data.email is string && isSuperAdminEmail(resource.data.email)
             && request.resource.data.status != resource.data.status)
      ) || (
        request.auth != null && request.auth.uid == playerId
        && request.resource.data.status == resource.data.status
        && request.resource.data.sessionsAttended == resource.data.sessionsAttended
        && request.resource.data.role == resource.data.role
      );

      allow delete: if isAdmin()
        && !(resource.data.email is string && isSuperAdminEmail(resource.data.email));
    }

    // Public-safe copy of an APPROVED player: name, photo, skill rating,
    // birth month/day only (no birth year, address, phone, or email).
    // Written only by an admin when they approve a signup from admin.html.
    // A protected (super-admin) player's roster entry can't be deleted —
    // that's the "membership" revocation this account is immune to.
    match /roster/{playerId} {
      allow read: if true;
      allow create: if isAdmin();
      // A player can update ONLY the public-facing fields they control
      // from their own profile page (name, nickname, photo, skill rating,
      // birth month/day) on their own roster entry, so editing their
      // profile syncs to the leaderboard/Meet the Club immediately,
      // without needing an admin to re-save it. aliases and
      // sessionsAttended stay admin-controlled either way.
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == playerId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['firstName', 'lastName', 'nickname', 'photoURL', 'skillRating', 'birthMonth', 'birthDay'])
      );
      allow delete: if isAdmin()
        && !isSuperAdminEmail(get(/databases/$(database)/documents/players/$(playerId)).data.email);
    }

    // Shop orders, placed straight from a product page's checkout modal —
    // no login required to buy. Anyone can create an order (validated below),
    // but only admins can read the list, change status, or delete — this is
    // the only way order details (name, contact, payment ref) get exposed.
    match /orders/{orderId} {
      allow create: if
        request.resource.data.status == 'pending'
        && request.resource.data.product is string && request.resource.data.product.size() > 0
        && request.resource.data.size is string && request.resource.data.size.size() > 0
        && request.resource.data.qty is int && request.resource.data.qty > 0
        && request.resource.data.total is number && request.resource.data.total > 0
        && request.resource.data.fullName is string && request.resource.data.fullName.size() > 0
        && request.resource.data.contactNumber is string && request.resource.data.contactNumber.size() > 0
        && request.resource.data.fbName is string && request.resource.data.fbName.size() > 0
        && request.resource.data.email is string && request.resource.data.email.size() > 0;

      // A signed-in player can also read their own orders (matched by the
      // email on the order, not a stored uid, since checkout doesn't
      // require login) — this is what powers "My Orders" on the profile
      // page. Everything else — status changes, deletes — stays admin-only.
      allow read: if isAdmin()
        || (request.auth != null && request.auth.token.email == resource.data.email);
      allow update, delete: if isAdmin();
    }

    // Discount codes, checked client-side at checkout when a buyer types one
    // in. Public read so the checkout modal can look one up without being
    // signed in; only admins can create, edit, or remove codes.
    match /discountCodes/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coaching session requests, placed from the coaching page's form —
    // no login required. Anyone can create a request (validated below),
    // but only admins can read, change status, or delete — same shape as
    // orders, since this replaced the old Google Form.
    match /coachingRequests/{requestId} {
      allow create: if
        request.resource.data.status == 'pending'
        && request.resource.data.fullName is string && request.resource.data.fullName.size() > 0
        && request.resource.data.contactNumber is string && request.resource.data.contactNumber.size() > 0
        && request.resource.data.email is string && request.resource.data.email.size() > 0
        && request.resource.data.preferredDate is string && request.resource.data.preferredDate.size() > 0
        && request.resource.data.timeslots is list && request.resource.data.timeslots.size() > 0
        && request.resource.data.players is int && request.resource.data.players > 0
        && request.resource.data.total is number && request.resource.data.total > 0;

      // A signed-in player can also read their own coaching requests
      // (matched by email, same as orders). This is what powers "My
      // Coaching Requests" on the profile page.
      allow read: if isAdmin()
        || (request.auth != null && request.auth.token.email == resource.data.email);
      // The Coach assigned to a request can update ONLY its status and
      // confirmed date (from their limited dashboard view), never the
      // payment fields. Everything else, including reassigning a coach
      // or deleting, stays admin-only.
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == resource.data.assignedCoach
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedDate'])
      );
      allow delete: if isAdmin();
    }

    // Coach-safe mirror of an assigned coaching request, keyed by the SAME
    // doc id as its coachingRequests/{requestId} record. This is what a
    // Coach's limited dashboard view reads. Deliberately excludes
    // coachingCost/courtFees/total/paymentMethod/paymentRef/paymentProofURL,
    // so a Coach account can never see what a player paid, only who/when/
    // how many players. Written by admin.html on assignment and on any
    // status/date change; a Coach can update ONLY status/confirmedDate on
    // their own assigned mirror doc, mirroring the coachingRequests rule
    // above (both docs get written together from the same UI action).
    match /coachingAssignments/{requestId} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.assignedCoach);
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == resource.data.assignedCoach
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedDate'])
      );
      allow delete: if isAdmin();
    }

    // Public-safe coaching status mirror, keyed by the SAME doc id as its
    // coachingRequests/{requestId} record. This is what the public
    // /track/ page reads so a requester can check their session status
    // without logging in. Deliberately excludes name/phone/email; only
    // dates, timeslots, players, total, and status. Written by the
    // coaching page on submit (create), and kept in sync by admin.html
    // whenever status or the confirmed date changes.
    match /coachingStatus/{requestId} {
      allow read: if true;
      allow create: if
        request.resource.data.status == 'pending'
        && request.resource.data.preferredDate is string && request.resource.data.preferredDate.size() > 0
        && request.resource.data.timeslots is list && request.resource.data.timeslots.size() > 0
        && request.resource.data.players is int && request.resource.data.players > 0
        && request.resource.data.total is number && request.resource.data.total > 0;
      allow update, delete: if isAdmin();
    }

    // Simple auto-incrementing counters (currently just "orders", used to
    // generate human-friendly order numbers at checkout). No PII here —
    // public can read/create/increment-by-exactly-1, which is the only
    // shape a legitimate checkout transaction produces.
    match /counters/{counterId} {
      allow read: if true;
      allow create: if request.resource.data.value is int && request.resource.data.value > 0;
      allow update: if request.resource.data.value is int
        && resource.data.value is int
        && request.resource.data.value == resource.data.value + 1;
    }

    // Public-safe order status mirror, keyed by orderNumber (NOT the
    // orders/{orderId} doc id) — this is what the public /track/ page reads
    // so a buyer can check their order without logging in. Deliberately
    // excludes name/phone/email/address; only items, statuses, and totals.
    // Written by checkout on create, and kept in sync by admin.html
    // whenever a line item's payment or fulfillment status changes.
    match /orderStatus/{orderNumber} {
      allow read: if true;
      allow create: if request.resource.data.items is list && request.resource.data.items.size() > 0
        && request.resource.data.total is number && request.resource.data.total > 0;
      allow update, delete: if isAdmin();
    }

    // Open play schedule sessions, shown in the homepage's "This Week's
    // Schedule" widget. Public read so the homepage can render it without
    // logging in; only admins can add, edit, or remove sessions.
    match /scheduleSessions/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cheer counter for homepage hype sections (currently the "Representing
    // OCPC" cheer button) — a lightweight public reaction count, not tied
    // to accounts. Anyone can create a cheer doc at 1, or bump it by
    // exactly 1; nothing else about the doc is writable.
    match /cheers/{cheerId} {
      allow read: if true;
      allow create: if request.resource.data.count is int && request.resource.data.count == 1;
      allow update: if request.resource.data.count is int && resource.data.count is int
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count']);
    }

    // Public messages of support left under a cheer (e.g. the First Serve
    // wall of support). Anyone can post one; only admins can remove a
    // message (moderation from admin.html).
    match /cheerMessages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.cheerId is string && request.resource.data.cheerId.size() > 0
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 280;
      allow delete: if isAdmin();
    }

    // Local (Philippines) donation submissions from the /giving/ page —
    // no login required. Anyone can create a submission (validated below),
    // but only admins can read, change status, or delete — same shape as
    // orders and coaching requests.
    match /donations/{donationId} {
      allow create: if
        request.resource.data.status == 'pending'
        && request.resource.data.fullName is string && request.resource.data.fullName.size() > 0
        && request.resource.data.contactNumber is string && request.resource.data.contactNumber.size() > 0
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.paymentMethod is string && request.resource.data.paymentMethod.size() > 0;

      allow read, update, delete: if isAdmin();
    }

    // Public-safe Donor Board mirror for the /giving/board/ page, keyed by
    // the donations/{donationId} doc id. Only ever contains a display name
    // and tier, nothing private. Written by admin.html when a donation is
    // marked "received" (and removed if unmarked or deleted), the same
    // sync pattern used for orderStatus.
    match /donorBoard/{donationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Player-submitted testimonials for the homepage "Why We Love OCPC"
    // carousel, from the /testimonials/ page. Public create (moderated
    // before going live); a pending submission is only visible to admins,
    // an approved one is visible to everyone. That's what lets the
    // homepage carousel query approved testimonials without exposing the
    // unmoderated queue to a public listing.
    match /testimonials/{testimonialId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if
        request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.quote is string && request.resource.data.quote.size() > 0 && request.resource.data.quote.size() <= 280;
      allow update, delete: if isAdmin();
    }

    // Site-wide settings, hand-edited from admin.html (currently just the
    // scrolling announce bar shown at the top of every page). Public read
    // so every page can render it without logging in; admin-only write.
    // If a doc is missing, pages treat it as disabled — so this feature
    // is "off" by default until an admin explicitly turns it on.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
